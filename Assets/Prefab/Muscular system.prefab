    del tri\xE1ngulo anal\n-Esf\xEDnter anal externo\n\r\n;;;FR;;;\r\n\n\n\nMUSCLES
    DU BASSIN\n\n\n -Corps p\xE9rin\xE9al\n - Septum post-anale\n -Raph\xE9 du diaphragme
