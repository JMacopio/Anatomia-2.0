--- !u!114 &4075747996227892398
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4075747996227892392}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 00fda604ac3af404a8e8a7571f24c19d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  allNames:
  - muscular system of upper limb
  - systema musculare membri superioris
  - "syst\xE8me musculaire du membre sup\xE9rieur"
  - sistema muscular del miembro superior
  - sistema muscular do membro superior
  - sistema muscolare dell'arto superiore
  - spierstelsel van de bovenste ledematen
  - "muskelsystem der oberen extremit\xE4t"
  - "uk\u0142ad mi\u0119\u015Bniowy ko\u0144czyny g\xF3rnej"
  - "\u4E0A\u80A2\u808C\u8089\u7CFB\u7D71"
  description: "MUSCULAR SYSTEM OF UPPER LIMB\r\n\r\n\r\nSHOULDER\r\n\r\n    Posterior:\r\n       
    Supraspinatus, infraspinatus, teres minor, subscapularis, deltoideus, latissimus
    dorsi, teres major\r\n    \r\n    Anterior:\r\n        Pectoralis major, coracobrachialis\r\n       
    \r\nARM\r\n\r\n    Posterior:\r\n        Triceps brachii, Anconeus\r\n       
    \r\n    Anterior:\r\n        Brachialis, Biceps brachii\r\n        \r\nFOREARM\r\n\r\n   
    Posterior:\r\n        (Superficial) extensor digitorum, extensor digiti minimi,
    extensor carpi ulnaris, (deep) supinator, abductor pollicis longus, extensor
    pollicis brevis, extensor pollicis longus, extensor indicis\r\n        \r\n   
    Anterior:\r\n        (Superficial) pronator teres, flexor digitorum superficialis,
    flexor carpi radialis, flexor carpi ulnaris, palmaris longus, (deep) flexor digitorum
    profundus, flexor pollicis longus, pronator quadratus\r\n        \r\n    Radial:\r\n           
    Brachioradialis, extensor carpi radialis longus, extensor carpi radialis brevis\r\n           
    \r\nHAND\r\n\r\n    Metacarpal:\r\n        Lumbricals, palmar introssei, dorsal
    interossei \r\n        \r\n    Thenar:\r\n        Abductor pollicis brevis, adductor
    pollicis, flexor pollicis brevis, opponens pollicis\r\n        \r\n    Hypothenar:\r\n       
    Abductor digiti minimi, flexor digiti minimi, opponens digiti minimi, palmaris
    brevis\r\n;;;ES;;;\r\n\n\n\nSISTEMA MUSCULAR DE LA EXTREMIDAD SUPERIOR\n\n\nHOMBRO\n\n
    Posterior:\n Supraespinoso, infraespinoso, redondo menor, subescapular, deltoides,
    dorsal ancho, redondo mayor\n \nAnterior:\n Pectoral mayor, coracobraquial\n
    \nBRAZO\n\n Posterior:\n Tr\xEDceps braquial, anc\xF3neo\n \nAnterior:\n braquial,
    b\xEDceps braquial\n \nANTEBRAZO\n\n Posterior:\n(Superficial) extensor digitorum,
    extensor digiti minimi, extensor carpi ulnaris, (profundo) supinador, abductor
    pollicis longus, extensor pollicis brevis, extensor pollicis longus, extensor
    indicis\n \nAnterior:\nPronador redondo (superficial), flexor superficial de
    los dedos, flexor radial del carpo, flexor cubital del carpo, palmar largo, flexor
    profundo de los dedos (profundo), flexor largo del pulgar, pronador cuadrado\n
    \nRadial:\nBraquiorradial, extensor carpi radialis longus, extensor carpi radialis
    brevis\n \nMANO\n\nMetacarpiano:\nLumbricales, introssei palmar, interosei dorsal\n
    \nTenar:\nAbductor pollicis brevis, aductor pollicis, flexor pollicis brevis,
    oponens pollicis\n \nhipotenar:\nAbductor digiti minimi, flexor digiti minimi,
    oponente digiti minimi, palmaris brevis\n\r\n;;;FR;;;\r\n\n\n\nSYST\xC8ME MUSCULAIRE
    DU MEMBRE SUP\xC9RIEUR\n\n\n\xC9PAULE\n\n Post\xE9rieur:\n Supraspinatus, infraspinatus,
    teres minor, subscapularis, deltoideus, latissimus dorsi, teres major\n \n Ant\xE9rieur:\n
    Grand pectoral, coracobrachial\n \nBRAS\n\n Post\xE9rieur:\n Triceps brachial,
    Ancon\xE9\n \n Ant\xE9rieur:\n Brachial, Biceps brachial\n \nAVANT BRAS\n\n Post\xE9rieur:\n
    Extensor digitorum (superficiel), extensor digiti minimi, extensor carpi ulnaris,
    supinator (profond), abductor pollicis longus, extensor pollicis brevis, extensor
    pollicis longus, extensor indicis\n \n Ant\xE9rieur:\n Pronator teres (superficiel),
    flexor digitorum superficialis, flexor carpi radialis, flexor carpi ulnaris,
    palmaris longus, (profond) flexor digitorum profundus, flexor pollicis longus,
    pronator quadratus\n \n Radial:\n Brachioradialis, extensor carpi radialis longus,
    extensor carpi radialis brevis\n \nMAIN\n\n M\xE9tacarpien\_:\n Lumbricals, introssei
    palmaire, interossei dorsal \n \n Th\xE9nar\_:\n Court abducteur du pouce, court
    adducteur du pouce, court fl\xE9chisseur du pouce, adversaire du pouce\n \n Hypoth\xE9nar\_:\n
    Abducteur digiti minimi, flexor digiti minimi, opponens digiti minimi, palmaris
    brevis\n\r\n;;;PT;;;\r\n\n\n\nSISTEMA MUSCULAR DO MEMBRO SUPERIOR\n\n\nOMBRO\n\nPosterior:\nSupraespinhal,
    infraespinhal, redondo menor, subescapular, deltoideus, latissimus dorsi, redondo
    maior\n \nAnterior:\nPeitoral maior, coracobraquial\n \nBRA\xC7O\n\nPosterior:\nTr\xEDceps
    braquial, Anc\xF4neo\n \nAnterior:\nBraquial, B\xEDceps braquial\n \nANTEBRA\xC7O\n\nPosterior:\n(Superficial)
    extensor dos dedos, extensor do dedo m\xEDnimo, extensor ulnar do carpo, (profundo)
    supinador, abdutor longo do polegar, extensor curto do polegar, extensor longo
    do polegar, extensor do indicador\n \nAnterior:\n(Superficial) pronador redondo,
    flexor superficial dos dedos, flexor radial do carpo, flexor ulnar do carpo,
    palmar longo, (profundo) flexor profundo dos dedos, flexor longo do polegar,
    pronador quadrado\n \nRadial:\nBraquiorradial, extensor radial longo do carpo,
    extensor radial curto do carpo\n \nM\xC3O\n\nMetacarpo:\nLumbricais, introsseos
    palmares, inter\xF3sseos dorsais\n \nTenar:\nAbdutor curto do polegar, adutor
    do polegar, flexor curto do polegar, oponente do polegar\n \nHipotenar:\nAbdutor
    do dedo m\xEDnimo, flexor do dedo m\xEDnimo, oponente do dedo m\xEDnimo, palmar
    curto\n"
