  - abdominaler teil der muskulatur
  - "brzuszna cz\u0119\u015B\u0107 uk\u0142adu mi\u0119\u015Bniowego"
  - "\u808C\u8089\u7CFB\u7D71\u7684\u8179\u90E8"
  description: "ABDOMINAL PART OF MUSCULAR SYSTEM\r\n\r\n\r\n    Muscles of abdomen\r\n   
    Fasciae of abdomen\r\n;;;ES;;;\r\n\n\n\nPARTE ABDOMINAL DEL SISTEMA MUSCULAR\n\n\nmusculos
    del abdomen\nfascias del abdomen\n\r\n;;;FR;;;\r\n\n\n\nPARTIE ABDOMINALE DU
    SYST\xC8ME MUSCULAIRE\n\n\nMuscles de l'abdomen\nFascias de l'abdomen\n\r\n;;;PT;;;\r\n\n\n\nPARTE
    ABDOMINAL DO SISTEMA MUSCULAR\n\n\nM\xFAsculos do abd\xF4men\nF\xE1scia do abd\xF4men\n"
