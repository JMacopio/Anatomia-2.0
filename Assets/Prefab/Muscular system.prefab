MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1475302894793761164}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 00fda604ac3af404a8e8a7571f24c19d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  allNames:
  - fasciae of lower limb
  - fasciae membri inferiori
  - "fascias du membre inf\xE9rieur"
  - fascias de miembros inferiores
  - "f\xE1scia de membro inferior"
  - fascie degli arti inferiori
  - fasciae van de onderste ledematen
  - "faszien der unteren extremit\xE4t"
  - "powi\u0119\u017A ko\u0144czyny dolnej"
  - "\u4E0B\u80A2\u7B4B\u819C"
  description: "FASCIAE OF LOWER LIMB\r\n\r\n\r\nFascia lata\r\n    Iliotibial tract\r\nLateral
    femoral intermuscular septum\r\nMedial femoral intermuscular septum\r\nVasto-adductor
    membrane\r\nMuscular space\r\nIliopectineal arch\r\nVascular space\r\nFemoral
    sheath\r\n    Femoral canal\r\n    Femoral ring\r\n    Femoral septum\r\nFemoral
    triangle\r\nSaphenous hiatus\r\n    Falciform margin of saphenous hiatus\r\n       
    Superior horn of falciform margin\r\n        Inferior horn of falciform margin\r\n   
    Cribriform fascia\r\nPopliteal fascia\r\nCrural fascia\r\nAnterior intermuscular
    septum of leg\r\nPosterior intermuscular septum of leg\r\nTransverse intermuscular
    septum of leg\r\nSuperior extensor retinaculum of ankle\r\nInferior extensor
    retinaculum of ankle\r\nFlexor retinaculum of ankle\r\nSuperior fibular retinaculum\r\nInferior
    fibular retinaculum\r\nDorsal fascia of foot\r\nPlantar aponeurosis\r\nCalcaneometatarsal
    ligament\r\n    Transverse fascicles of plantar aponeurosis\r\nSuperficial transverse
    metatarsal ligament\r\n;;;ES;;;\r\n\n\n\nFASCIAE DE LA EXTREMIDAD INFERIOR\n\n\nfascia
    lata\n Tracto iliotibial\nTabique intermuscular femoral lateral\nTabique intermuscular
    femoral medial\nMembrana vasoaductora\nespacio muscular\nArco iliopect\xEDneo\nespacio
    vascular\nvaina femoral\n canal femoral\n anillo femoral\n tabique femoral\ntri\xE1ngulo
    femoral\nhiato safeno\n Margen falciforme del hiato safeno\n Cuerno superior
    del margen falciforme\n Cuerno inferior del borde falciforme\nFascia cribiforme\nFascia
    popl\xEDtea\nFascia crural\nTabique intermuscular anterior de la pierna\nTabique
    intermuscular posterior de la pierna\nTabique intermuscular transverso de la
    pierna\nRetin\xE1culo extensor superior del tobillo\nRetin\xE1culo extensor inferior
    del tobillo\nRetin\xE1culo flexor del tobillo\nRetin\xE1culo fibular superior\nRetin\xE1culo
    fibular inferior\nFascia dorsal del pie\nAponeurosis plantar\nLigamento calcaneometatarsiano\nFasc\xEDculos
    transversos de la aponeurosis plantar\nLigamento metatarsiano transverso superficial\n\r\n;;;FR;;;\r\n\n\n\nFASCIA
    DU MEMBRE INF\xC9RIEUR\n\n\nFascia lata\nTractus ilio-tibial\nSeptum intermusculaire
    f\xE9moral lat\xE9ral\nSeptum intermusculaire f\xE9moral m\xE9dial\nMembrane
    vasto-adducteur\nEspace muscl\xE9\nArc ilio-pectin\xE9\nEspace vasculaire\nGaine
    f\xE9morale\nCanal f\xE9moral\nAnneau f\xE9moral\nSeptum f\xE9moral\nTriangle
    f\xE9moral\nHiatus saph\xE8ne\nMarge falciforme du hiatus saph\xE8ne\nCorne sup\xE9rieure
    de la marge falciforme\nCorne inf\xE9rieure de la marge falciforme\nFascia cribriforme\nFascia
    poplit\xE9\nFascia crural\nSeptum intermusculaire ant\xE9rieur de la jambe\nSeptum
    intermusculaire post\xE9rieur de la jambe\nSeptum intermusculaire transversal
    de la jambe\nR\xE9tinaculum extenseur sup\xE9rieur de la cheville\nR\xE9tinaculum
    extenseur inf\xE9rieur de la cheville\nR\xE9tinaculum fl\xE9chisseur de la cheville\nR\xE9tinaculum
    fibulaire sup\xE9rieur\nR\xE9tinaculum fibulaire inf\xE9rieur\nFascia dorsal
    du pied\nApon\xE9vrose plantaire\nLigament calcan\xE9o-m\xE9tatarsien\nFascicules
    transverses de l'apon\xE9vrose plantaire\nLigament m\xE9tatarsien transverse
    superficiel\n\r\n;;;PT;;;\r\n\n\n\nF\xC1SCIA DO MEMBRO INFERIOR\n\n\nF\xE1scia
    lata\nTrato iliotibial\nSepto intermuscular femoral lateral\nSepto intermuscular
    femoral medial\nMembrana Vasto-adutor\nEspa\xE7o muscular\nArco iliopect\xEDneo\nEspa\xE7o
    vascular\nBainha femoral\nCanal femoral\nAnel femoral\nSepto femoral\nTri\xE2ngulo
    femoral\nHiato safeno\nMargem falciforme do hiato safeno\nCorno superior da margem
    falciforme\nCorno inferior da margem falciforme\nF\xE1scia cribriforme\nF\xE1scia
    popl\xEDtea\nF\xE1scia Crural\nSepto intermuscular anterior da perna\nSepto intermuscular
    posterior da perna\nSepto intermuscular transverso da perna\nRetin\xE1culo extensor
    superior do tornozelo\nRetin\xE1culo extensor inferior do tornozelo\nRetin\xE1culo
    flexor do tornozelo\nRetin\xE1culo fibular superior\nRetin\xE1culo fibular inferior\nF\xE1scia
    dorsal do p\xE9\nAponeurose plantar\nLigamento calc\xE2neometatarsal\nFasc\xEDculos
    transversos da aponeurose plantar\nLigamento metatarsal transverso superficial\n"
